# Copy to service/.env (gitignored) and fill in. Never commit real strings.
#
# Pooled connection (PgBouncer, transaction mode) — used by the running service's
# Pool in db.mjs. Neon's dashboard labels this "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Direct (non-pooled) connection — used by load.mjs and verify.mjs only. Schema DDL,
# COPY FROM STDIN and ANALYZE can break under transaction pooling. Neon's dashboard
# labels this the direct/unpooled connection (host without "-pooler").
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
